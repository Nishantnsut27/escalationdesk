# Optional: enables live Groq investigations. Keep this file free of real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional explicit proxy for Groq. Empty means direct HTTPS with TLS verification.
# The backend does not inherit HTTP_PROXY/HTTPS_PROXY from its launching shell.
GROQ_PROXY_URL=
# Local defaults:
DESK_PORT=8000
DESK_DATA_DIR=data
DESK_ORIGIN=http://127.0.0.1:8000

