# Optional: enables live Groq investigations. Keep this file free of real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional explicit proxy for Groq. Empty means direct HTTPS with TLS verification.
# The backend does not inherit HTTP_PROXY/HTTPS_PROXY from its launching shell.
GROQ_PROXY_URL=
# Optional advisory Jev triage, billed through the configured OpenRouter account.
# Secrets may also be placed in backend/.env; the process/root .env take precedence.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_PROXY_URL=
# Local defaults:
DESK_PORT=8020
DESK_DATA_DIR=data
DESK_ORIGIN=http://127.0.0.1:8020

# Optional Sentry public integration. All credentials stay on the backend.
# HTTPS origin only; sign in at this URL for OAuth (e.g. your development tunnel).
DESK_PUBLIC_URL=
SENTRY_APP_SLUG=
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
# Generate once with scripts/configure_sentry.py; retain outside the database.
DESK_CONNECTION_KEY=
# Explicit opt-in for real reference-service telemetry; consumes Sentry allowance.
SENTRY_REFERENCE_ENABLED=0
SENTRY_GATEWAY_DSN=
SENTRY_ORDER_DSN=
SENTRY_PAYMENT_DSN=


# The normal workspace does not run reference services or expose fault controls.
DESK_ENABLE_LAB=0
# Separate, explicitly invoked telemetry test application only.
SENTRY_TEST_DSN=
